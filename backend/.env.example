# Copy this file to `.env` in the same folder and fill in your real key.
# `.env` is gitignored and must never be committed.

# Required. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional. Port the Express server listens on.
PORT=3000

# Optional. Realtime model used for the voice conversation.
#
# gpt-realtime-2.1-mini  - roughly 3x cheaper on audio. Recommended while
#                          building and testing. Handles a booking script well.
# gpt-realtime-2.1       - best voice quality. Worth switching to when
#                          recording or presenting the demo.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Optional. Cal.com diary write for confirmed bookings.
# Leave blank and bookings are still stored locally in data/bookings.json;
# Cal.com is best-effort and never blocks a call from completing.
#
# Create an API key in Cal.com → Settings → Developer / API.
# Event type id: open the event type in Cal.com; the numeric id is in the URL
# or available from GET /v2/event-types.
# CALCOM_API_KEY=cal_live_your_key_here
# CALCOM_EVENT_TYPE_ID=123456
#
# Optional Cal.com tuning:
# CALCOM_TIMEZONE=Africa/Johannesburg
# CALCOM_DEFAULT_ATTENDEE_EMAIL=bookings@yourstudio.co.za
# CALCOM_GUEST_EMAIL_DOMAIN=guest.yourstudio.co.za
# CALCOM_LOCATION_TYPE=none
#   Use attendeePhone only if that location is enabled on the event type.

# Optional. Receptionist base language pack.
# en = English default; agent still switches to Afrikaans mid-call if the
#      caller speaks Afrikaans or asks for it (website stays English).
# af = Force Afrikaans-only spoken replies for the whole session (T-11 lab).
# RECEPTIONIST_LOCALE=en

# Optional. Voice the receptionist speaks with.
# Options: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# marin and cedar are the highest quality.
# OPENAI_REALTIME_VOICE=marin
