# Copy this file to `.env` in the same folder and fill in your real key.
# `.env` is gitignored and must never be committed.

# Required. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional. Port the Express server listens on.
PORT=3000

# Optional. Realtime model used for the voice conversation.
#
# gpt-realtime-2.1-mini  - roughly 3x cheaper on audio. Recommended while
#                          building and testing. Handles a booking script well.
# gpt-realtime-2.1       - best voice quality. Worth switching to when
#                          recording or presenting the demo.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Optional. n8n webhook that receives each confirmed booking as JSON.
# Leave blank and bookings are still stored locally in data/bookings.json;
# the webhook is best-effort and never blocks a call from completing.
#
# Copy this from the Production URL shown on the webhook node in n8n rather
# than assembling it by hand. Duplicating a webhook node makes n8n generate a
# new random path, so the URL will not always end in `bella-booking`.
# The workflow must be Active or this URL returns 404.
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/bella-booking

# Optional. The webhook node's Test URL, used only for manual verification.
# The app never reads this; run the server with N8N_WEBHOOK_URL set to this
# value to test against n8n's one-shot "Execute workflow" listener.
# N8N_WEBHOOK_TEST_URL=https://your-n8n-instance/webhook-test/bella-booking

# Optional. Only used by `node scripts/test-smtp.js`, which checks whether a
# mail server accepts these credentials before you put them into n8n. The app
# itself never sends email; n8n does that.
# For Gmail, SMTP_PASS must be a 16-character App Password with no spaces:
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcdefghijklmnop

# Optional. Voice the receptionist speaks with.
# Options: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# marin and cedar are the highest quality.
# OPENAI_REALTIME_VOICE=marin
